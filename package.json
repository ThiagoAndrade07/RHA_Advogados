{
  "name": "rhm-advogados",
  "version": "1.0.0",
  "private": true,
  "description": "Site RHM Advogados exportado do projeto Sequential Website Content Assembler no Stitch.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build:css": "tailwindcss -i src/styles.css -o assets/styles.css --minify",
    "build": "npm run build:css && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/serve.mjs dist"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17"
  }
}
